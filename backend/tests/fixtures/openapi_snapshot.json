 "info": {
  "description": "AI Powered YouTube Auto Clipper",
  "title": "XORACLIPS API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/analyze": {
   "post": {
    "description": "Stream real-time progress via Server-Sent Events, then deliver the final result.\nThe Gemini key comes only from the X-Gemini-Api-Key header (issue #12).",
    "operationId": "analyze_video_api_analyze_post",
    "parameters": [
     {
      "in": "header",
      "name": "X-Gemini-Api-Key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Gemini-Api-Key"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AnalyzeRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Analyze Video"
   }
  },
  "/api/audio/{file_name}": {
   "get": {
    "operationId": "get_audio_file_api_audio__file_name__get",
    "parameters": [
     {
      "in": "path",
      "name": "file_name",
      "required": true,
      "schema": {
       "title": "File Name",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Audio File"
   }
  },
  "/api/caption-chunks": {
   "post": {
    "description": "The caption chunks a clip's export will burn in, for the browser preview.\nUses the same function as generate_ass_file(), so preview == render.\nTimes are relative to clip_start. Empty when the transcript has no words\nin this clip (or there is no transcript): the render then falls back to\nWhisper, which the preview cannot match.",
    "operationId": "get_caption_chunks_api_caption_chunks_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CaptionChunksRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Caption Chunks"
   }
  },
  "/api/clear-temp": {
   "post": {
    "description": "Clears all temporary downloaded video clips, audio slices, ASS files, and frames\nfrom TEMP_DIR and backend/temp. Re-creates empty directories.\nPROTECTED: cookies.txt and any cookie files are strictly PRESERVED and NEVER deleted.",
    "operationId": "clear_temp_folder_api_clear_temp_post",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Clear Temp Folder"
   }
  },
  "/api/clip-frame": {
   "get": {
    "description": "The video frame at timestamp for the preview backdrop. When YouTube gives\nno frame for that second, a stand-in (another second, or the thumbnail)\nthat the browser must not keep (issue #44).\nTakes only a video ID (issue #42): the YouTube URL is built here, never sent.",
    "operationId": "get_clip_frame_api_clip_frame_get",
    "parameters": [
     {
      "in": "query",
      "name": "video_id",
      "required": true,
      "schema": {
       "title": "Video Id",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "timestamp",
      "required": false,
      "schema": {
       "default": 0.0,
       "maximum": 86400,
       "minimum": 0,
       "title": "Timestamp",
       "type": "number"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Get Clip Frame"
   }
  },
  "/api/cookies": {
   "delete": {
    "operationId": "delete_youtube_cookies_api_cookies_delete",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Delete Youtube Cookies"
   },
   "get": {
    "description": "Whether cookies are saved, their size and domains. Never their content:\nthe cookies are a YouTube login (issue #45).",
    "operationId": "get_youtube_cookies_status_api_cookies_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Get Youtube Cookies Status"
   },
   "post": {
    "operationId": "save_youtube_cookies_api_cookies_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CookiesSaveRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Save Youtube Cookies"
   }
  },
  "/api/detect-face": {
   "get": {
    "description": "Detects speaker face coordinates (cx, cy, w, h) on the video at timestamp.\nReturns normalized coordinates and the frame URL.\nTakes only a video ID (issue #42): the YouTube URL is built here, never sent.",
    "operationId": "detect_face_api_detect_face_get",
    "parameters": [
     {
      "in": "query",
      "name": "video_id",
      "required": true,
      "schema": {
       "title": "Video Id",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "timestamp",
